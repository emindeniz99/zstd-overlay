#!/usr/bin/env python3
"""zstd-overlay: transparent zstd compression for folders on a Linux VM, built
for Claude Code cloud sessions (30 GB disk, root, kernel with btrfs and
overlayfs). Python 3.11+, standard library only; installs nothing: an empty
btrfs image ships at the end of this file, and the kernel does the rest.

Every write under a mounted folder lands in a compressed btrfs image. What the
folder held before stays where it was and stays readable. Programs see plain
files; pnpm, cargo, uv, dotnet and the rest need no flags.

Usage:
  zstd-overlay up [DIR...]         mount DIRs (default list when none is given)
  zstd-overlay up --merge DIR...   mount DIR although it changed while unmounted;
                                   the changed files win (look first: `doctor`)
  zstd-overlay up --hook [DIR...]  as up, for a SessionStart hook: exits 0 and
                                   reports refused folders in JSON
  zstd-overlay migrate DIR...      move what DIR already holds into the image
  zstd-overlay install             copy to /usr/local/bin and add a SessionStart hook
  zstd-overlay status              disk use, capacity, mounted folders
  zstd-overlay doctor              what is mounted, what is not, and why

Default list: the folder holding $CLAUDE_PROJECT_DIR (in a cloud session
/home/user, so every repository, also one attached later, is covered; the
repository itself if that folder is a protected one), ~/.cache, ~/.local/share,
~/.local/bin, ~/.npm, and whichever of ~/.rustup ~/.cargo ~/go ~/.m2 ~/.gradle
~/.nuget ~/.dotnet ~/.bun exist.

A VM restore drops every mount, so `install` runs `up --hook` from a
SessionStart hook. A folder written to while it was not mounted is not mounted
again (those writes would be hidden under the image); `up` names the files and
leaves the folder on the normal disk until you decide.

The image reserves its disk space up front (fallocate), leaving
ZSTD_OVERLAY_RESERVE_MB free outside it. A disk that fills from outside then
gives the writer outside a plain "No space left"; the image, whose blocks are
already its own, keeps working. (A sparse image would take that error itself,
as an I/O error, and btrfs would turn read-only.)

Environment: ZSTD_OVERLAY_IMG (default /var/lib/zstd-overlay/disk.img),
ZSTD_OVERLAY_MNT (default /mnt/zstd-overlay), ZSTD_OVERLAY_RESERVE_MB (4096).

Exit status: 0 done; 2 an error stopped it; 3 some folders were refused.
"""

from __future__ import annotations

import base64
import contextlib
import fcntl
import io
import json
import os
import shutil
import struct
import subprocess
import sys
import tarfile
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

MiB = 1 << 20
GiB = 1 << 30
OPTS = "noatime,compress-force=zstd:3,nodiscard"
HOOK_COMMAND = "/usr/local/bin/zstd-overlay up --hook"
INSTALL_PATH = Path("/usr/local/bin/zstd-overlay")
LOCK_PATH = "/run/zstd-overlay.lock"
SHRINK_STEP = 256 * MiB
MIN_CAPACITY = 512 * MiB
BTRFS_IOC_RESIZE = 0x50009403  # _IOW(0x94, 3, struct btrfs_ioctl_vol_args), 4096 bytes
LOOP_SET_CAPACITY = 0x4C07

# Folders that must never be covered. `/usr/local/...` and `/opt/<tool>` are allowed.
SYSTEM = {
    "/", "/bin", "/boot", "/dev", "/etc", "/home", "/lib", "/lib64", "/opt", "/proc", "/root",
    "/run", "/sbin", "/srv", "/sys", "/usr", "/var", "/var/lib",
}  # fmt: skip
DEFAULT_TOOL_DIRS = (".rustup", ".cargo", "go", ".m2", ".gradle", ".nuget", ".dotnet", ".bun")


class Stop(Exception):
    """A precondition failed; exit 2 with this message."""


def say(msg: str) -> None:
    print(f"zstd-overlay: {msg}", flush=True)


def gib(n: int) -> str:
    return f"{n / GiB:.1f} GiB"


def key_of(path: str) -> str:
    return path.replace("/", "%")


@dataclass
class Config:
    img: str
    mnt: str
    reserve: int
    home: str
    project: str

    @classmethod
    def from_env(cls, env: dict[str, str] | None = None) -> Config:
        env = dict(os.environ if env is None else env)
        return cls(
            img=os.path.realpath(env.get("ZSTD_OVERLAY_IMG", "/var/lib/zstd-overlay/disk.img")),
            mnt=os.path.realpath(env.get("ZSTD_OVERLAY_MNT", "/mnt/zstd-overlay")),
            reserve=int(env.get("ZSTD_OVERLAY_RESERVE_MB", "4096")) * MiB,
            home=env.get("HOME", "/root"),
            project=env.get("CLAUDE_PROJECT_DIR", ""),
        )


# --- pure logic (unit-tested) -------------------------------------------------


def unescape_mountinfo(s: str) -> str:
    """/proc/self/mountinfo writes space, tab, newline and backslash as octal escapes."""
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\" and i + 3 < len(s) and s[i + 1 : i + 4].isdigit():
            out.append(chr(int(s[i + 1 : i + 4], 8)))
            i += 4
        else:
            out.append(s[i])
            i += 1
    return "".join(out)


@dataclass
class Mount:
    target: str
    fstype: str
    source: str
    options: str  # mount options + super options, comma-joined


def parse_mountinfo(text: str) -> list[Mount]:
    mounts = []
    for line in text.splitlines():
        if " - " not in line:
            continue
        left, right = line.split(" - ", 1)
        lf, rf = left.split(), right.split()
        if len(lf) < 6 or len(rf) < 3:
            continue
        mounts.append(Mount(unescape_mountinfo(lf[4]), rf[0], unescape_mountinfo(rf[1]), f"{lf[5]},{rf[2]}"))
    return mounts


def our_overlays(mounts: list[Mount], mnt: str) -> list[str]:
    marker = f"upperdir={mnt}/upper/"
    return [m.target for m in mounts if m.fstype == "overlay" and marker in m.options]


def inside(path: str, parent: str) -> bool:
    """path is parent or below it."""
    return path == parent or path.startswith(parent.rstrip("/") + "/")


def guard(path: str, cfg: Config, mounted: list[str]) -> str | None:
    """Why `path` must not be mounted, or None."""
    if path in SYSTEM or path.startswith("/opt/claude-code") or inside(path, "/var/lib/dpkg"):
        return "a system folder"
    if inside(path, "/usr") and not path.startswith("/usr/local/"):
        return "a system folder"
    claude = os.path.join(cfg.home, ".claude")
    for p in (claude, cfg.mnt, cfg.img):
        if inside(p, path):
            return f"it holds {p}"
    for p in (claude, cfg.mnt):
        if inside(path, p):
            return f"it is inside {p}"
    for o in mounted:
        if o == path:
            continue
        if inside(path, o):
            return f"it is inside {o}, which is already mounted"
        if inside(o, path):
            return f"it holds {o}, which is already mounted"
    return None


def resolve(dirs: list[str]) -> tuple[list[str], list[str]]:
    """Absolute, deduplicated; a folder listed inside another listed one is refused."""
    absolute = list(dict.fromkeys(os.path.realpath(d) for d in dirs if d))
    keep, refused = [], []
    for d in absolute:
        outer = next((o for o in absolute if o != d and inside(d, o)), None)
        if outer:
            refused.append(f"refused: {d} (it is inside {outer}, also listed)")
        else:
            keep.append(d)
    return keep, refused


def workspace(cfg: Config) -> str:
    """The folder that holds the session's repository, so repositories cloned next to it later
    (a cloud session puts them all under /home/user) are covered too. The repository itself
    when that folder must not be covered (/root, /home, ...)."""
    project = os.path.realpath(cfg.project)
    parent = os.path.dirname(project)
    return parent if guard(parent, cfg, []) is None else project


def default_dirs(cfg: Config) -> list[str]:
    dirs = [workspace(cfg)] if cfg.project else []
    dirs += [os.path.join(cfg.home, d) for d in (".cache", ".local/share", ".local/bin", ".npm")]
    dirs += [os.path.join(cfg.home, d) for d in DEFAULT_TOOL_DIRS if os.path.isdir(os.path.join(cfg.home, d))]
    return dirs


def target_capacity(held: int, avail: int, reserve: int) -> int:
    """What the image may take: its own blocks + free disk - reserve, whole MiB, at least MIN_CAPACITY."""
    return max(MIN_CAPACITY, (held + avail - reserve) // MiB * MiB)


def shrink_steps(cur: int, target: int, step: int = SHRINK_STEP) -> list[int]:
    """Sizes to resize through on the way down. One big shrink must move every block group
    above the new end at once and often fails with ENOSPC; 256 MiB steps succeed (measured)."""
    sizes, size = [], cur
    while size > target:
        size = max(target, size - step)
        sizes.append(size)
    return sizes


def changed_since(root: str, stamp_ns: int) -> list[str]:
    """Paths under root (one filesystem) whose ctime is newer than stamp_ns. ctime, not mtime:
    `cp -a` and `tar -p` can set mtime back, nothing sets ctime back. A delete changes the
    folder's ctime, so deletions show up as their folder."""
    dev = os.lstat(root).st_dev
    found, stack = [], [root]
    while stack:
        d = stack.pop()
        try:
            st = os.lstat(d)
            if st.st_ctime_ns > stamp_ns:
                found.append(d)
            with os.scandir(d) as it:
                entries = list(it)
        except OSError:
            continue
        for e in entries:
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            if e.is_dir(follow_symlinks=False):
                if st.st_dev == dev:
                    stack.append(e.path)
            elif st.st_ctime_ns > stamp_ns:
                found.append(e.path)
    return sorted(found)


def tree_sig(root: str) -> tuple[int, int]:
    """(entries, bytes in regular files): what `migrate` compares before deleting."""
    entries, size = 1, 0
    for d, dirs, files in os.walk(root):
        entries += len(dirs) + len(files)
        for f in files:
            st = os.lstat(os.path.join(d, f))
            if not os.path.islink(os.path.join(d, f)):
                size += st.st_size
    return entries, size


def merge_hook(settings: dict, command: str = HOOK_COMMAND) -> dict:
    """settings with one SessionStart hook running `command`, replacing earlier zstd-overlay hooks."""
    hooks = settings.setdefault("hooks", {})
    entries = hooks.setdefault("SessionStart", [])

    def ours(entry: dict) -> bool:
        return any(str(h.get("command", "")).startswith(str(INSTALL_PATH) + " ") for h in entry.get("hooks", []))

    entries[:] = [e for e in entries if not ours(e)]
    entries.append({"matcher": "startup|resume", "hooks": [{"type": "command", "command": command, "timeout": 600}]})
    return settings


def hook_output(lines: list[str], refused: int) -> str:
    """What `up --hook` prints. Claude Code reads a SessionStart hook's stdout only on exit 0:
    plain text becomes context for Claude; JSON can also warn the user."""
    text = "\n".join(lines)
    if not refused:
        return text
    context = (
        text + "\nSome folders were left on the normal disk, uncompressed, so that nothing is hidden. "
        "Tell the user which ones and why. Run `zstd-overlay up --merge DIR` only after the user "
        "has looked at the listed files and agreed."
    )
    return json.dumps(
        {
            "systemMessage": (
                f"zstd-overlay: {refused} folder(s) not compressed this session; details: zstd-overlay doctor"
            ),
            "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context},
        }
    )


# --- the machine ----------------------------------------------------------------


def run(*cmd: str) -> None:
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise Stop(f"{' '.join(cmd)}: {r.stderr.strip() or f'exit {r.returncode}'}")


def mounts_now() -> list[Mount]:
    return parse_mountinfo(Path("/proc/self/mountinfo").read_text())


def mount_at(target: str) -> Mount | None:
    found = [m for m in mounts_now() if m.target == target]
    return found[-1] if found else None


def backing_file(loopdev: str) -> str:
    p = Path(f"/sys/block/{os.path.basename(loopdev)}/loop/backing_file")
    return p.read_text().strip() if p.exists() else ""


def fs_size(path: str) -> int:
    s = os.statvfs(path)
    return s.f_blocks * s.f_frsize


def fs_avail(path: str) -> int:
    s = os.statvfs(path)
    return s.f_bavail * s.f_frsize


def allocated(path: str) -> int:
    return os.stat(path).st_blocks * 512


def btrfs_resize(mnt: str, size: int) -> str | None:
    """None on success, the error otherwise. BTRFS_IOC_RESIZE needs no btrfs-progs."""
    arg = bytearray(struct.pack("q4088s", 0, str(size).encode()))
    fd = os.open(mnt, os.O_RDONLY)
    try:
        fcntl.ioctl(fd, BTRFS_IOC_RESIZE, arg)
        return None
    except OSError as e:
        return e.strerror or str(e)
    finally:
        os.close(fd)


def loop_refresh(dev: str) -> None:
    fd = os.open(dev, os.O_RDONLY)
    try:
        fcntl.ioctl(fd, LOOP_SET_CAPACITY, 0)
    finally:
        os.close(fd)


def reserve_blocks(img: str, size: int) -> None:
    fd = os.open(img, os.O_WRONLY)
    try:
        os.posix_fallocate(fd, 0, size)
    finally:
        os.close(fd)


@dataclass
class Session:
    cfg: Config
    refused: int = 0
    lines: list[str] = field(default_factory=list)
    quiet: bool = False

    def say(self, msg: str) -> None:
        self.lines.append(f"zstd-overlay: {msg}")
        if not self.quiet:
            say(msg)

    def refuse(self, msg: str) -> None:
        self.refused += 1
        self.say(msg)

    # --- the image ---

    def mount_image(self) -> None:
        cfg = self.cfg
        m = mount_at(cfg.mnt)
        if m:
            back = backing_file(m.source)
            if back != cfg.img:
                raise Stop(f"{cfg.mnt} is mounted from {back or m.source}, not {cfg.img}")
            if m.options.split(",")[0] == "ro":
                raise Stop(
                    f"the image went read-only (see dmesg). Save what you need, unmount the folders "
                    f"and {cfg.mnt}, then run up again"
                )
            self.fit_image()
            return
        os.makedirs(os.path.dirname(cfg.img), exist_ok=True)
        os.makedirs(cfg.mnt, exist_ok=True)
        if not os.path.exists(cfg.img):
            with tempfile.TemporaryDirectory(dir=os.path.dirname(cfg.img), prefix=".new.") as tmp:
                with tarfile.open(fileobj=io.BytesIO(base64.b64decode(BLOB))) as t:
                    member = t.getmember("disk.img")
                    if hasattr(tarfile, "data_filter"):
                        t.extract(member, tmp, filter="data")
                    else:  # Python 3.11 before 3.11.4
                        t.extract(member, tmp)
                os.replace(os.path.join(tmp, "disk.img"), cfg.img)
        run("mount", "-o", f"loop,{OPTS}", cfg.img, cfg.mnt)
        for d in ("upper", "work", "stamps"):
            os.makedirs(os.path.join(cfg.mnt, d), exist_ok=True)
        self.fit_image()

    def fit_image(self) -> None:
        """Capacity = the image's own blocks + free disk - reserve, all of it allocated, so the
        blocks are the image's before btrfs writes to them. Grows when the disk has room;
        shrinks when writes outside ate into the reserve."""
        cfg = self.cfg
        m = mount_at(cfg.mnt)
        assert m is not None
        dev, cur = m.source, fs_size(cfg.mnt)
        avail = fs_avail(os.path.dirname(cfg.img))
        target = target_capacity(allocated(cfg.img), avail, cfg.reserve)
        if abs(target - cur) >= SHRINK_STEP:
            if target > cur:
                try:
                    reserve_blocks(cfg.img, target)
                except OSError:
                    self.say("warning: no room to grow the image")
                    return
                loop_refresh(dev)
                if err := btrfs_resize(cfg.mnt, target):
                    self.say(f"warning: could not grow the image to {gib(target)} ({err})")
            else:
                size, err = cur, None
                for step in shrink_steps(cur, target):
                    err = btrfs_resize(cfg.mnt, step)
                    if err:  # btrfs frees a deleted file's blocks only after a commit
                        os.sync()
                        time.sleep(2)
                        err = btrfs_resize(cfg.mnt, step)
                    if err:
                        break
                    size = step
                if size < cur:
                    os.truncate(cfg.img, size)
                    loop_refresh(dev)
                if size > target:
                    self.say(
                        f"warning: only {gib(avail)} free outside the image (reserve {gib(cfg.reserve)}); "
                        f"the image gave back {gib(cur - size)} of {gib(cur - target)} ({err})"
                    )
        cur = fs_size(cfg.mnt)
        if allocated(cfg.img) < cur:  # a fresh (sparse) image: claim its blocks now
            try:
                reserve_blocks(cfg.img, cur)
            except OSError:
                self.say("warning: could not reserve the image's space; writes outside could break it")

    # --- folders ---

    def stamp(self, path: str) -> str:
        return os.path.join(self.cfg.mnt, "stamps", key_of(path))

    def changed(self, path: str) -> list[str]:
        stamp = self.stamp(path)
        if not os.path.exists(stamp) or not os.path.isdir(path):
            return []
        return changed_since(path, os.stat(stamp).st_mtime_ns)

    def mount_dir(self, path: str, merge: bool = False) -> bool:
        cfg = self.cfg
        mounted = our_overlays(mounts_now(), cfg.mnt)
        if path in mounted:
            return True
        if why := guard(path, cfg, mounted):
            self.refuse(f"refused: {path} ({why})")
            return False
        os.makedirs(path, exist_ok=True)
        changed = self.changed(path)
        if changed and not merge:
            self.refuse(f"NOT MOUNTED: {path} changed while it was not mounted; mounting would hide these:")
            for p in changed[:20]:
                self.say(f"    {p}")
            if len(changed) > 20:
                self.say(f"    ... and {len(changed) - 20} more")
            self.say(f"  it stays on the normal disk. Keep those changes: zstd-overlay up --merge {path}")
            return False
        key = key_of(path)
        aside = None
        if changed:  # --merge: set the changed files aside, mount, put them back on top
            aside = tempfile.mkdtemp(dir=cfg.mnt, prefix="merge.")
            for p in changed:
                if not os.path.isdir(p) or os.path.islink(p):
                    rel = os.path.relpath(p, path)
                    os.makedirs(os.path.join(aside, os.path.dirname(rel)), exist_ok=True)
                    copy_entry(p, os.path.join(aside, rel))
        for d in ("upper", "work"):
            os.makedirs(os.path.join(cfg.mnt, d, key), exist_ok=True)
        run(
            "mount", "-t", "overlay", "overlay", "-o",
            f"lowerdir={path},upperdir={cfg.mnt}/upper/{key},workdir={cfg.mnt}/work/{key}", path,
        )  # fmt: skip
        if aside:
            run("cp", "-a", f"{aside}/.", f"{path}/")
            shutil.rmtree(aside)
            self.say(f"merged {len(changed)} changed paths into {path}")
        Path(self.stamp(path)).touch()
        self.say(f"compressed: {path}")
        self.stale_processes(path)
        return True

    def stale_processes(self, path: str) -> None:
        """A process that was already inside `path` keeps the old folder as its working
        directory: what it writes by relative path goes there, under the mount. Claude Code
        itself is not one of them: it resolves its working directory by path for every
        command, so commands it starts after the mount see the image (checked in a session
        on 2026-11-02)."""
        lower_dev = os.stat(os.path.dirname(path)).st_dev
        names = []
        for pid in filter(str.isdigit, os.listdir("/proc")):
            if pid == str(os.getpid()):
                continue
            try:
                if os.readlink(f"/proc/{pid}/exe").endswith("/claude"):
                    continue
                cwd = os.readlink(f"/proc/{pid}/cwd")
                if not inside(cwd, path) or os.stat(f"/proc/{pid}/cwd").st_dev != lower_dev:
                    continue
                cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
            except OSError:
                continue
            names.append(f"{pid}:{cmd.strip()[:40]}")
        if names:
            more = ", ..." if len(names) > 4 else ""
            self.say(f"  note: {len(names)} process(es) started earlier still work in the old {path}; what they")
            self.say(f"  write by relative path goes under the mount. Restart them if they write there: "
                     f"{', '.join(names[:4])}{more}")  # fmt: skip

    # --- commands ---

    def up(self, dirs: list[str], merge: bool = False) -> None:
        if merge and not dirs:
            raise Stop("--merge needs the folders to merge")
        self.mount_image()
        keep, refused = resolve(dirs or default_dirs(self.cfg))
        for r in refused:
            self.refuse(r)
        for d in keep:
            self.mount_dir(d, merge)

    def migrate(self, dirs: list[str]) -> None:
        if not dirs:
            raise Stop("migrate needs folders")
        cfg = self.cfg
        self.mount_image()
        keep, refused = resolve(dirs)
        for r in refused:
            self.refuse(r)
        for d in keep:
            if (cfg.project and inside(os.path.realpath(cfg.project), d)) or os.path.exists(os.path.join(d, ".git")):
                self.refuse(f"refused: {d} is a repository; repositories are mounted, never migrated")
                continue
            if d in our_overlays(mounts_now(), cfg.mnt):
                self.say(f"skipped: {d} is mounted already; migrate runs before the first mount of a session")
                continue
            if not os.path.isdir(d):
                self.say(f"skipped: {d} does not exist")
                continue
            if not self.mount_dir(d):
                continue
            key = key_of(d)
            new = os.path.join(cfg.mnt, "upper", key + ".migrating")
            shutil.rmtree(new, ignore_errors=True)
            os.makedirs(new)
            # Copy the merged view: it already hides what was deleted and shows the newest version.
            run("cp", "-a", "--reflink=auto", f"{d}/.", f"{new}/")
            before, after = tree_sig(d), tree_sig(new)
            if before != after:
                shutil.rmtree(new)
                self.refuse(f"migrate aborted: the copy of {d} has {after} (entries, bytes), expected {before}; "
                            "nothing changed")  # fmt: skip
                continue
            run("umount", d)
            old = d + ".zstd-overlay-old"
            os.rename(d, old)
            st = os.stat(old)
            os.mkdir(d)
            os.chmod(d, st.st_mode & 0o7777)
            os.chown(d, st.st_uid, st.st_gid)
            shutil.rmtree(os.path.join(cfg.mnt, "upper", key))
            shutil.rmtree(os.path.join(cfg.mnt, "work", key), ignore_errors=True)
            os.rename(new, os.path.join(cfg.mnt, "upper", key))
            with contextlib.suppress(FileNotFoundError):
                os.unlink(self.stamp(d))
            if self.mount_dir(d) and tree_sig(d) == before:
                shutil.rmtree(old)
                self.say(f"migrated: {d} ({gib(before[1])} now in the image)")
            else:
                self.refuse(f"migrate check failed: {old} kept; nothing deleted")

    def install(self) -> None:
        settings = Path(self.cfg.home, ".claude", "settings.json")
        me = Path(__file__).resolve()
        if me != INSTALL_PATH:
            shutil.copyfile(me, INSTALL_PATH)
            INSTALL_PATH.chmod(0o755)
        settings.parent.mkdir(parents=True, exist_ok=True)
        try:
            current = json.loads(settings.read_text()) if settings.exists() and settings.stat().st_size else {}
        except json.JSONDecodeError as e:
            raise Stop(f"{settings} is not valid JSON ({e}); left unchanged") from None
        if not isinstance(current, dict):
            raise Stop(f"{settings} is not a JSON object; left unchanged")
        fd, tmp = tempfile.mkstemp(dir=settings.parent, prefix="settings.json.")
        with os.fdopen(fd, "w") as f:
            json.dump(merge_hook(current), f, indent=2)
            f.write("\n")
        os.replace(tmp, settings)
        self.say(f"installed {INSTALL_PATH} and a SessionStart hook in {settings}")
        self.say("the image is created at the first session start, not now")

    def status(self) -> None:
        cfg = self.cfg
        if not mount_at(cfg.mnt):
            self.say("image not mounted (run: zstd-overlay up)")
            return
        stored = sum(
            os.lstat(os.path.join(d, f)).st_size for d, _, fs in os.walk(os.path.join(cfg.mnt, "upper")) for f in fs
        )
        free = fs_avail(os.path.dirname(cfg.img))
        self.say(
            f"stored {gib(stored)}; image capacity {gib(fs_size(cfg.mnt))} "
            f"(reserved on disk: {gib(allocated(cfg.img))}); free outside the image {gib(free)}"
        )
        for o in our_overlays(mounts_now(), cfg.mnt):
            print(f"  {o}")

    def doctor(self) -> None:
        self.status()
        image = mount_at(self.cfg.mnt) is not None
        mounted = our_overlays(mounts_now(), self.cfg.mnt)
        for d in default_dirs(self.cfg):
            d = os.path.realpath(d)
            if d in mounted:
                print(f"  ok        {d}")
            elif why := guard(d, self.cfg, mounted):
                print(f"  refused   {d} ({why})")
            elif image and (n := len(self.changed(d))):
                print(f"  CHANGED   {d} ({n} paths changed while unmounted; see: zstd-overlay up {d})")
            else:
                print(f"  unmounted {d}")


def copy_entry(src: str, dst: str) -> None:
    """Copy one file or symlink with its mode, times and owner."""
    st = os.lstat(src)
    shutil.copy2(src, dst, follow_symlinks=False)
    os.lchown(dst, st.st_uid, st.st_gid)


@contextlib.contextmanager
def locked(path: str = LOCK_PATH, wait: float = 120):
    with open(path, "w") as f:
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise Stop("another zstd-overlay is running") from None
                time.sleep(0.2)
        yield


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    cmd = args.pop(0) if args else "help"
    if cmd in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0
    if cmd not in ("up", "migrate", "install", "status", "doctor"):
        print(f"zstd-overlay: unknown command: {cmd} (see --help)", file=sys.stderr)
        return 2
    if os.geteuid() != 0:
        print("zstd-overlay: needs root (it mounts)", file=sys.stderr)
        return 2
    hook = merge = False
    while args and args[0] in ("--hook", "--merge"):
        hook |= args[0] == "--hook"
        merge |= args[0] == "--merge"
        args.pop(0)
    s = Session(Config.from_env(), quiet=hook)
    try:
        with locked():
            if cmd == "up":
                s.up(args, merge)
            elif cmd == "migrate":
                s.migrate(args)
            else:
                getattr(s, cmd)()
    except Stop as e:
        print(f"zstd-overlay: {e}", file=sys.stderr)
        return 2
    if hook:
        print(hook_output(s.lines, s.refused))
        return 0
    return 3 if s.refused else 0


