from pathlib import Path

MiB = 1 << 20
GiB = 1 << 30
OPTS = "noatime,compress-force=zstd:3,nodiscard"
HOOK_COMMAND = "/usr/local/bin/zstd-overlay up --hook"
INSTALL_PATH = Path("/usr/local/bin/zstd-overlay")
LOCK_PATH = "/run/zstd-overlay.lock"
SHRINK_STEP = 256 * MiB
MIN_CAPACITY = 512 * MiB
BTRFS_IOC_RESIZE = 0x50009403  # _IOW(0x94, 3, struct btrfs_ioctl_vol_args), 4096 bytes
LOOP_SET_CAPACITY = 0x4C07
LOOP_SET_DIRECT_IO = 0x4C08
# `git archive` fills this in (.gitattributes: export-subst); a checkout leaves it as is.
COMMIT = "$Format:%h %cI$"

# Folders that must never be covered. `/usr/local/...` and `/opt/<tool>` are allowed.
SYSTEM = {
    "/", "/bin", "/boot", "/dev", "/etc", "/home", "/lib", "/lib64", "/opt", "/proc", "/root",
    "/run", "/sbin", "/srv", "/sys", "/usr", "/var", "/var/lib",
}  # fmt: skip
DEFAULT_TOOL_DIRS = (".rustup", ".cargo", "go", ".m2", ".gradle", ".nuget", ".dotnet", ".bun")


class Stop(Exception):
    """A precondition failed; exit 2 with this message."""


def say(msg: str) -> None:
    print(f"zstd-overlay: {msg}", flush=True)


def gib(n: int) -> str:
    return f"{n / GiB:.1f} GiB"


def key_of(path: str) -> str:
    return path.replace("/", "%")


@dataclass
class Config:
    img: str
    mnt: str
    reserve: int
    home: str
    project: str

    @classmethod
    def from_env(cls, env: dict[str, str] | None = None) -> Config:
        env = dict(os.environ if env is None else env)
        return cls(
            img=os.path.realpath(env.get("ZSTD_OVERLAY_IMG", "/var/lib/zstd-overlay/disk.img")),
            mnt=os.path.realpath(env.get("ZSTD_OVERLAY_MNT", "/mnt/zstd-overlay")),
            reserve=int(env.get("ZSTD_OVERLAY_RESERVE_MB", "4096")) * MiB,
            home=env.get("HOME", "/root"),
            project=env.get("CLAUDE_PROJECT_DIR", ""),
        )


# --- pure logic (unit-tested) -------------------------------------------------


def unescape_mountinfo(s: str) -> str:
    """/proc/self/mountinfo writes space, tab, newline and backslash as octal escapes."""
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\" and i + 3 < len(s) and s[i + 1 : i + 4].isdigit():
            out.append(chr(int(s[i + 1 : i + 4], 8)))
            i += 4
        else:
            out.append(s[i])
            i += 1
    return "".join(out)


@dataclass
class Mount:
    target: str
    fstype: str
    source: str
    options: str  # mount options + super options, comma-joined


def parse_mountinfo(text: str) -> list[Mount]:
    mounts = []
    for line in text.splitlines():
        if " - " not in line:
            continue
        left, right = line.split(" - ", 1)
        lf, rf = left.split(), right.split()
        if len(lf) < 6 or len(rf) < 3:
            continue
        mounts.append(Mount(unescape_mountinfo(lf[4]), rf[0], unescape_mountinfo(rf[1]), f"{lf[5]},{rf[2]}"))
    return mounts


def our_overlays(mounts: list[Mount], mnt: str) -> list[str]:
    marker = f"upperdir={mnt}/upper/"
    return [m.target for m in mounts if m.fstype == "overlay" and marker in m.options]


def inside(path: str, parent: str) -> bool:
    """path is parent or below it."""
    return path == parent or path.startswith(parent.rstrip("/") + "/")


def guard(path: str, cfg: Config, mounted: list[str]) -> str | None:
    """Why `path` must not be mounted, or None."""
    if "%" in path:  # key_of() writes "/" as "%": /a%b and /a/b would share one layer
        return "its path contains %"
    if path in SYSTEM or path.startswith("/opt/claude-code") or inside(path, "/var/lib/dpkg"):
        return "a system folder"
    if inside(path, "/usr") and not path.startswith("/usr/local/"):
        return "a system folder"
    claude = os.path.join(cfg.home, ".claude")
    for p in (claude, cfg.mnt, cfg.img):
        if inside(p, path):
            return f"it holds {p}"
    for p in (claude, cfg.mnt):
        if inside(path, p):
            return f"it is inside {p}"
    for o in mounted:
        if o == path:
            continue
        if inside(path, o):
            return f"it is inside {o}, which is already mounted"
        if inside(o, path):
            return f"it holds {o}, which is already mounted"
    return None


def resolve(dirs: list[str]) -> tuple[list[str], list[str]]:
    """Absolute, deduplicated; a folder listed inside another listed one is refused."""
    absolute = list(dict.fromkeys(os.path.realpath(d) for d in dirs if d))
    keep, refused = [], []
    for d in absolute:
        outer = next((o for o in absolute if o != d and inside(d, o)), None)
        if outer:
            refused.append(f"refused: {d} (it is inside {outer}, also listed)")
        else:
            keep.append(d)
    return keep, refused


def workspace(cfg: Config) -> str:
    """The folder that holds the session's repository, so repositories cloned next to it later
    (a cloud session puts them all under /home/user) are covered too. The repository itself
    when that folder must not be covered (/root, /home, ...)."""
    project = os.path.realpath(cfg.project)
    parent = os.path.dirname(project)
    return parent if guard(parent, cfg, []) is None else project


def default_dirs(cfg: Config) -> list[str]:
    dirs = [workspace(cfg)] if cfg.project else []
    dirs += [os.path.join(cfg.home, d) for d in (".cache", ".local/share", ".local/bin", ".npm")]
    dirs += [os.path.join(cfg.home, d) for d in DEFAULT_TOOL_DIRS if os.path.isdir(os.path.join(cfg.home, d))]
    return dirs


def target_capacity(held: int, avail: int, reserve: int) -> int:
    """What the image may take: its own blocks + free disk - reserve, whole MiB, at least MIN_CAPACITY."""
    return max(MIN_CAPACITY, (held + avail - reserve) // MiB * MiB)


def shrink_steps(cur: int, target: int, step: int = SHRINK_STEP) -> list[int]:
    """Sizes to resize through on the way down. One big shrink must move every block group
    above the new end at once and often fails with ENOSPC; 256 MiB steps succeed (measured)."""
    sizes, size = [], cur
    while size > target:
        size = max(target, size - step)
        sizes.append(size)
    return sizes


def changed_since(root: str, stamp_ns: int, skip: frozenset[str] = frozenset()) -> list[str]:
    """Files (not folders) under root, on one filesystem, whose ctime is newer than stamp_ns.
    ctime, not mtime: `cp -a` and `tar -p` can set mtime back, nothing sets ctime back.
    Folders in `skip` (the repositories' .git, which never go into the image) are not entered."""
    dev = os.lstat(root).st_dev
    found, stack = [], [root]
    while stack:
        d = stack.pop()
        try:
            with os.scandir(d) as it:
                entries = list(it)
        except OSError:
            continue
        for e in entries:
            try:
                st = e.stat(follow_symlinks=False)
            except OSError:
                continue
            if e.is_dir(follow_symlinks=False):
                if st.st_dev == dev and e.path not in skip:
                    stack.append(e.path)
            elif st.st_ctime_ns > stamp_ns:
                found.append(e.path)
    return sorted(found)


def real_dir(path: str) -> bool:
    """A folder, not a symlink to one: writing through a symlink would leave the layer."""
    return os.path.isdir(path) and not os.path.islink(path)


def is_whiteout(st: os.stat_result) -> bool:
    """overlayfs records a deleted file as a character device 0:0 in the upper layer."""
    return stat.S_ISCHR(st.st_mode) and st.st_rdev == 0


def is_opaque(path: str) -> bool:
    """An upper folder that replaced the lower one entirely (deleted, then created again)."""
    try:
        return os.getxattr(path, "trusted.overlay.opaque", follow_symlinks=False) == b"y"
    except OSError:
        return False


def hidden_by_upper(rel: str, upper: str) -> bool:
    """Would the image hide a change to the lower file `rel`? Only if the upper layer has an
    entry at that path, or a deleted or replaced folder above it. A lower file the image has no
    counterpart for shows through the mount unchanged."""
    parts = rel.split(os.sep)
    for i in range(1, len(parts) + 1):
        p = os.path.join(upper, *parts[:i])
        try:
            st = os.lstat(p)
        except FileNotFoundError:
            return False
        if i == len(parts) or is_whiteout(st) or (stat.S_ISDIR(st.st_mode) and is_opaque(p)):
            return True
        if not stat.S_ISDIR(st.st_mode):  # a file where the lower side has a folder: it hides it
            return True
    return False


def git_dirs(root: str, depth: int = 3) -> list[str]:
    """Repositories' .git folders under root, down to `depth` levels (a cloud session clones to
    /home/user/<repo> and /home/user/<owner>/<repo>). Does not enter node_modules or .git."""
    found = []
    if os.path.isdir(os.path.join(root, ".git")) and not os.path.islink(os.path.join(root, ".git")):
        found.append(os.path.join(root, ".git"))
    if depth == 0:
        return found
    try:
        with os.scandir(root) as it:
            subdirs = [e.path for e in it if e.is_dir(follow_symlinks=False) and e.name not in (".git", "node_modules")]
    except OSError:
        return found
    for d in sorted(subdirs):
        found += git_dirs(d, depth - 1)
    return found


def tree_sig(root: str) -> tuple[int, int]:
    """(entries, bytes in regular files): what `migrate` compares before deleting."""
    entries, size = 1, 0
    for d, dirs, files in os.walk(root):
        entries += len(dirs) + len(files)
        for f in files:
            st = os.lstat(os.path.join(d, f))
            if not os.path.islink(os.path.join(d, f)):
                size += st.st_size
    return entries, size


def merge_hook(settings: dict, command: str = HOOK_COMMAND) -> dict:
    """settings with one SessionStart hook running `command`, replacing earlier zstd-overlay hooks."""
    hooks = settings.setdefault("hooks", {})
    entries = hooks.setdefault("SessionStart", [])

    def ours(entry: dict) -> bool:
        return any(str(h.get("command", "")).startswith(str(INSTALL_PATH) + " ") for h in entry.get("hooks", []))

    entries[:] = [e for e in entries if not ours(e)]
    entries.append({"matcher": "startup|resume", "hooks": [{"type": "command", "command": command, "timeout": 600}]})
    return settings


def hook_output(lines: list[str], refused: int) -> str:
    """What `up --hook` prints. Claude Code reads a SessionStart hook's stdout only on exit 0:
    plain text becomes context for Claude; JSON can also warn the user."""
    text = "\n".join(lines)
    if not refused:
        return text
    context = (
        text + "\nSome folders were left on the normal disk, uncompressed, so that nothing is hidden. "
        "Tell the user which ones and why. Run `zstd-overlay up --merge DIR` only after the user "
        "has looked at the listed files and agreed."
    )
    return json.dumps(
        {
            "systemMessage": (
                f"zstd-overlay: {refused} folder(s) not compressed this session; details: zstd-overlay doctor"
            ),
            "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context},
        }
    )


# --- the machine ----------------------------------------------------------------


def run(*cmd: str) -> None:
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise Stop(f"{' '.join(cmd)}: {r.stderr.strip() or f'exit {r.returncode}'}")


def mounts_now() -> list[Mount]:
    return parse_mountinfo(Path("/proc/self/mountinfo").read_text())


def mount_at(target: str) -> Mount | None:
    found = [m for m in mounts_now() if m.target == target]
    return found[-1] if found else None


def backing_file(loopdev: str) -> str:
    p = Path(f"/sys/block/{os.path.basename(loopdev)}/loop/backing_file")
    return p.read_text().strip() if p.exists() else ""


def fs_size(path: str) -> int:
    s = os.statvfs(path)
    return s.f_blocks * s.f_frsize


def fs_avail(path: str) -> int:
    s = os.statvfs(path)
    return s.f_bavail * s.f_frsize


def allocated(path: str) -> int:
    return os.stat(path).st_blocks * 512


def btrfs_resize(mnt: str, size: int) -> str | None:
    """None on success, the error otherwise. BTRFS_IOC_RESIZE needs no btrfs-progs."""
    arg = bytearray(struct.pack("q4088s", 0, str(size).encode()))
    fd = os.open(mnt, os.O_RDONLY)
    try:
        fcntl.ioctl(fd, BTRFS_IOC_RESIZE, arg)
        return None
    except OSError as e:
        return e.strerror or str(e)
    finally:
        os.close(fd)


def loop_refresh(dev: str) -> None:
    fd = os.open(dev, os.O_RDONLY)
    try:
        fcntl.ioctl(fd, LOOP_SET_CAPACITY, 0)
    finally:
        os.close(fd)


def loop_direct_io(dev: str) -> bool:
    """Have the loop device read and write its file directly. Without it every block the image
    reads is cached twice, as the file's page and as btrfs's: 2 GiB of cache for 1 GiB read,
    and 1 GiB with it, with a 25% faster cold read (measured 2026-11-03). True once set."""
    with contextlib.suppress(OSError):
        if Path(f"/sys/block/{os.path.basename(dev)}/loop/dio").read_text().strip() == "1":
            return True
    try:
        with open(dev, "rb") as f:
            fcntl.ioctl(f, LOOP_SET_DIRECT_IO, 1)
        return True
    except OSError:
        return False


def reserve_blocks(img: str, size: int) -> None:
    fd = os.open(img, os.O_WRONLY)
    try:
        os.posix_fallocate(fd, 0, size)
    finally:
        os.close(fd)


@dataclass
class Session:
    cfg: Config
    refused: int = 0
    lines: list[str] = field(default_factory=list)
    quiet: bool = False

    def say(self, msg: str) -> None:
        self.lines.append(f"zstd-overlay: {msg}")
        if not self.quiet:
            say(msg)

    def refuse(self, msg: str) -> None:
        self.refused += 1
        self.say(msg)

    # --- the image ---

    def mount_image(self) -> None:
        cfg = self.cfg
        m = mount_at(cfg.mnt)
        if m:
            back = backing_file(m.source)
            if back != cfg.img:
                raise Stop(f"{cfg.mnt} is mounted from {back or m.source}, not {cfg.img}")
            if m.options.split(",")[0] == "ro":
                raise Stop(
                    f"the image went read-only (see dmesg). Save what you need, unmount the folders "
                    f"and {cfg.mnt}, then run up again"
                )
            self.direct_io(m.source)
            self.fit_image()
            return
        os.makedirs(os.path.dirname(cfg.img), exist_ok=True)
        os.makedirs(cfg.mnt, exist_ok=True)
        if not os.path.exists(cfg.img):
            with tempfile.TemporaryDirectory(dir=os.path.dirname(cfg.img), prefix=".new.") as tmp:
                with tarfile.open(fileobj=io.BytesIO(base64.b64decode(BLOB))) as t:
                    member = t.getmember("disk.img")
                    if hasattr(tarfile, "data_filter"):
                        t.extract(member, tmp, filter="data")
                    else:  # Python 3.11 before 3.11.4
                        t.extract(member, tmp)
                os.replace(os.path.join(tmp, "disk.img"), cfg.img)
        try:
            run("mount", "-o", f"loop,{OPTS}", cfg.img, cfg.mnt)
        except Stop as first:
            # A superblock or tree root half-written when the VM stopped: btrfs keeps the last
            # roots, and usebackuproot mounts the newest one that reads whole.
            try:
                run("mount", "-o", f"loop,usebackuproot,{OPTS}", cfg.img, cfg.mnt)
            except Stop as second:
                raise Stop(f"the image does not mount: {first}; nor from a backup root: {second}") from None
            self.say(
                f"the image did not mount ({first}); mounted from a backup root (usebackuproot), "
                "so writes from the last seconds before the VM stopped may be missing"
            )
        for d in ("upper", "work", "stamps"):
            os.makedirs(os.path.join(cfg.mnt, d), exist_ok=True)
        m = mount_at(cfg.mnt)
        assert m is not None
        self.direct_io(m.source)
        self.fit_image()

    def direct_io(self, dev: str) -> None:
        if not loop_direct_io(dev):
            self.say(f"note: {dev} refused direct I/O; what the image reads is cached twice in memory")

    def fit_image(self) -> None:
        """Capacity = the image's own blocks + free disk - reserve, all of it allocated, so the
        blocks are the image's before btrfs writes to them. Grows when the disk has room;
        shrinks when writes outside ate into the reserve."""
        cfg = self.cfg
        m = mount_at(cfg.mnt)
        assert m is not None
        dev, cur = m.source, fs_size(cfg.mnt)
        avail = fs_avail(os.path.dirname(cfg.img))
        target = target_capacity(allocated(cfg.img), avail, cfg.reserve)
        if abs(target - cur) >= SHRINK_STEP:
            if target > cur:
                try:
                    reserve_blocks(cfg.img, target)
                except OSError:
                    self.say("warning: no room to grow the image")
                    return
                loop_refresh(dev)
                if err := btrfs_resize(cfg.mnt, target):
                    self.say(f"warning: could not grow the image to {gib(target)} ({err})")
            else:
                size, err = cur, None
                # btrfs removes block groups emptied by deletes only after a commit, in the
                # background: the first step was refused (ENOSPC) for 22 s in one measurement.
                deadline = time.monotonic() + 45
                for step in shrink_steps(cur, target):
                    err = btrfs_resize(cfg.mnt, step)
                    while err and time.monotonic() < deadline:
                        os.sync()
                        time.sleep(3)
                        err = btrfs_resize(cfg.mnt, step)
                    if err:
                        break
                    size = step
                if size < cur:
                    os.truncate(cfg.img, size)
                    loop_refresh(dev)
                if size > target:
                    self.say(
                        f"warning: only {gib(avail)} free outside the image (reserve {gib(cfg.reserve)}); "
                        f"the image gave back {gib(cur - size)} of {gib(cur - target)} ({err})"
                    )
        cur = fs_size(cfg.mnt)
        if allocated(cfg.img) < cur:  # a fresh (sparse) image: claim its blocks now
            try:
                reserve_blocks(cfg.img, cur)
            except OSError:
                self.say("warning: could not reserve the image's space; writes outside could break it")

    # --- folders ---

    def stamp(self, path: str) -> str:
        return os.path.join(self.cfg.mnt, "stamps", key_of(path))

    def upper(self, path: str) -> str:
        return os.path.join(self.cfg.mnt, "upper", key_of(path))

    def hidden(self, path: str, repos: bool = True) -> list[str]:
        """Files written on the normal disk since `path` was last mounted that mounting would
        hide, because the image has its own version of them. Writes the image has no version
        of show through and need nothing. The repositories' .git never goes into the image,
        so writes there (the platform rewrites every .git/config on resume) never count."""
        stamp = self.stamp(path)
        if not os.path.exists(stamp) or not os.path.isdir(path):
            return []
        changed = changed_since(path, os.stat(stamp).st_mtime_ns, frozenset(git_dirs(path) if repos else ()))
        upper = self.upper(path)
        return [p for p in changed if hidden_by_upper(os.path.relpath(p, path), upper)]

    def write_back_startup_files(self, path: str) -> None:
        """Claude Code read each repository's CLAUDE.md, .claude/ and .mcp.json from the normal
        disk when it started, a few seconds ago, before this hook. Move the image's newer
        versions of them down to the normal disk, so the next start reads them, and tell Claude
        that this start read the older ones."""
        upper = self.upper(path)
        roots = {os.path.dirname(g) for g in git_dirs(path)}
        if self.cfg.project and inside(os.path.realpath(self.cfg.project), path):
            roots.add(os.path.realpath(self.cfg.project))
        written: list[str] = []
        deleted: list[str] = []
        for root in sorted(roots):
            rel_root = os.path.relpath(root, path)
            rels = [os.path.normpath(os.path.join(rel_root, f)) for f in STARTUP_FILES]
            w, d = write_back(upper, path, rels)
            written += [os.path.join(path, r) for r in w]
            deleted += [os.path.join(path, r) for r in d]
        for verb, paths in (("wrote", written), ("deleted", deleted)):
            if paths:
                shown = ", ".join(paths[:6]) + (", ..." if len(paths) > 6 else "")
                where = "back to" if verb == "wrote" else "on"
                self.say(f"{verb} {len(paths)} startup files {where} the normal disk: {shown}")
        if written or deleted:
            self.say(
                "  note for Claude: Claude Code loaded the older copies of these at this start. "
                "Read CLAUDE.md again now; changes to .claude/ settings, hooks, skills and .mcp.json "
                "take effect at the next start."
            )

    def move_git_out(self, path: str) -> None:
        """Move each .git found in the image to the normal disk. Versions before 3d7ad8d+1 kept
        .git in the image; a repository cloned while mounted has its .git there too. Called
        while `path` is not mounted, so both layers are reachable directly."""
        upper = self.upper(path)
        for ug in git_dirs(upper):
            lg = os.path.join(path, os.path.relpath(ug, upper))
            merge_tree(ug, lg)
            shutil.rmtree(ug)
            self.say(f"moved {lg} out of the image (git metadata stays on the normal disk)")

    def recover_migration(self, path: str) -> bool:
        """Undo the second half of a migration that was killed (a VM pause during the first
        start can do it): `path` was renamed to `path.zstd-overlay-old` and an empty folder took
        its place. Put the original back; the image holds either its old layer or the verified
        copy, and either one over the original shows the folder as it was. The migration then
        simply runs again. False when both sides hold files, which nothing here writes."""
        old = path + ".zstd-overlay-old"
        if not os.path.isdir(old):
            return True
        if os.path.isdir(path) and os.listdir(path):
            self.refuse(f"refused: {path} and {old} both hold files (an interrupted migrate?); nothing changed")
            return False
        if os.path.isdir(path):
            os.rmdir(path)
        os.rename(old, path)
        shutil.rmtree(self.upper(path) + ".migrating", ignore_errors=True)
        self.say(f"recovered an interrupted migration of {path}; nothing was lost")
        return True

    def fold_nested_layers(self, path: str) -> None:
        """Fold into the normal disk the layer of any folder inside `path` that was mounted on
        its own before (versions up to dd94e60 mounted the repository, later ones the folder
        holding it). Its files would otherwise stay in the image, unseen. Newer file wins."""
        root = os.path.join(self.cfg.mnt, "upper")
        mounted = our_overlays(mounts_now(), self.cfg.mnt)
        for name in sorted(os.listdir(root)) if os.path.isdir(root) else []:
            inner = name.replace("%", "/")
            if name.endswith(".migrating") or inner == path or not inside(inner, path) or inner in mounted:
                continue
            os.makedirs(inner, exist_ok=True)
            merge_tree(os.path.join(root, name), inner)
            shutil.rmtree(os.path.join(root, name))
            shutil.rmtree(os.path.join(self.cfg.mnt, "work", name), ignore_errors=True)
            for stamp in (self.stamp(inner),):
                with contextlib.suppress(FileNotFoundError):
                    os.unlink(stamp)
            self.say(f"folded the earlier layer of {inner} into the normal disk (newer files win)")

    def mount_dir(
        self, path: str, merge: bool = False, cache: bool = False, quiet: bool = False, recover: bool = True
    ) -> bool:
        """Mount `path`. For a `cache` folder, first move everything the normal disk holds there
        into the image, so the folder below the mount is always empty. Otherwise a file the
        image would hide is a conflict: with `merge` the normal disk's version wins; without,
        the folder is refused and stays on the normal disk."""
        cfg = self.cfg
        mounted = our_overlays(mounts_now(), cfg.mnt)
        if path in mounted:
            return True
        if why := guard(path, cfg, mounted):
            self.refuse(f"refused: {path} ({why})")
            return False
        if recover and not self.recover_migration(path):
            return False
        os.makedirs(path, exist_ok=True)
        key, upper = key_of(path), self.upper(path)
        self.fold_nested_layers(path)
        repos = not cache  # repositories' .git is kept out of the image; caches go in whole
        if repos:
            self.move_git_out(path)
        else:
            # Whatever was written here while unmounted (the first time: everything the cloud
            # image ships; on a resume: what npm, MCP servers and Claude Code wrote before the
            # hook) is the newest, and nothing reads it but the tool that wrote it. It goes into
            # the image, and the folder below the mount stays empty: no conflicts, and no
            # reflink from the lower layer, which overlayfs refuses (EXDEV) and uv stops on.
            stamp = self.stamp(path)
            n, size = absorb(path, upper, os.stat(stamp).st_mtime_ns if os.path.exists(stamp) else None)
            if n:
                self.say(f"moved {n} files ({gib(size)}) from the normal disk into the image: {path}")
        hidden = self.hidden(path, repos)
        if hidden and not merge:
            self.refuse(f"NOT MOUNTED: {path} changed while it was not mounted; mounting would hide these:")
            for p in hidden[:20]:
                self.say(f"    {p}")
            if len(hidden) > 20:
                self.say(f"    ... and {len(hidden) - 20} more")
            self.say(f"  it stays on the normal disk. Keep those changes: zstd-overlay up --merge {path}")
            return False
        if repos:
            self.write_back_startup_files(path)
        aside = None
        if hidden:  # --merge: set the normal disk's files aside, mount, put them back on top
            aside = tempfile.mkdtemp(dir=cfg.mnt, prefix="merge.")
            for p in hidden:
                rel = os.path.relpath(p, path)
                os.makedirs(os.path.join(aside, os.path.dirname(rel)), exist_ok=True)
                copy_entry(p, os.path.join(aside, rel))
        for d in ("upper", "work"):
            os.makedirs(os.path.join(cfg.mnt, d, key), exist_ok=True)
        # The repositories' .git stays on the normal disk: hold each one at a bind mount inside
        # the image while the overlay goes up, then bind it back over the same path.
        lower_dev = os.stat(path).st_dev
        held = []
        for g in git_dirs(path) if repos else []:
            hold = os.path.join(cfg.mnt, "git", key_of(g))
            os.makedirs(hold, exist_ok=True)
            run("mount", "--bind", g, hold)
            held.append((g, hold))
        try:
            run(
                "mount", "-t", "overlay", "overlay", "-o",
                f"lowerdir={path},upperdir={upper},workdir={cfg.mnt}/work/{key}", path,
            )  # fmt: skip
        finally:
            for g, hold in held:
                if mount_at(path) and os.path.isdir(g):
                    run("mount", "--bind", hold, g)
                run("umount", hold)
        if aside:
            run("cp", "-a", f"{aside}/.", f"{path}/")
            shutil.rmtree(aside)
            self.say(f"merged {len(hidden)} changed files into {path} (the normal disk's versions win)")
        Path(self.stamp(path)).touch()
        if not quiet:
            self.say(f"compressed: {path}")
        self.stale_processes(path, lower_dev)
        return True

    def stale_processes(self, path: str, lower_dev: int) -> None:
        """A process that was already inside `path` keeps the old folder as its working
        directory: what it writes by relative path goes there, under the mount. Claude Code
        itself is not one of them: it resolves its working directory by path for every
        command, so commands it starts after the mount see the image (checked in a session
        on 2026-11-02)."""
        names = []
        mine = ancestors(os.getpid())  # this process and the shell or hook runner that started it
        # and the rest of its pipeline (`zstd-overlay up | tail`): same parent, same group. Not
        # the whole group: a hook runs in Claude Code's group, with the MCP servers it started.
        group, parent = os.getpgrp(), os.getppid()
        for pid in filter(str.isdigit, os.listdir("/proc")):
            if int(pid) in mine:
                continue
            try:
                if os.getpgid(int(pid)) == group and parent_of(int(pid)) == parent:
                    continue
                if os.readlink(f"/proc/{pid}/exe").endswith("/claude"):
                    continue
                cwd = os.readlink(f"/proc/{pid}/cwd")
                if not inside(cwd, path) or os.stat(f"/proc/{pid}/cwd").st_dev != lower_dev:
                    continue
                cmd = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
            except OSError:
                continue
            names.append(f"{pid}:{cmd.strip()[:40]}")
        if names:
            more = ", ..." if len(names) > 4 else ""
            self.say(f"  note: {len(names)} process(es) started earlier still work in the old {path}; what they")
            self.say(f"  write by relative path goes under the mount. Restart them if they write there: "
                     f"{', '.join(names[:4])}{more}")  # fmt: skip

    # --- commands ---

    def up(self, dirs: list[str], merge: bool = False) -> None:
        if merge and not dirs:
            raise Stop("--merge needs the folders to merge")
        self.mount_image()
        keep, refused = resolve(dirs or default_dirs(self.cfg))
        # The default home folders are caches and toolchains: what is written there while
        # unmounted moves into the image. The folder holding the repositories, and any folder
        # named on the command line, stay strict: a conflict refuses the folder.
        caches = (
            set()
            if dirs
            else {os.path.realpath(d) for d in default_dirs(self.cfg)}
            - {os.path.realpath(workspace(self.cfg)) if self.cfg.project else ""}
        )
        for r in refused:
            self.refuse(r)
        for d in keep:
            try:
                self.mount_dir(d, merge, cache=d in caches)
            except (Stop, OSError) as e:  # one folder's failure leaves the others to mount
                self.refuse(f"NOT MOUNTED: {d}: {e}")

    def migrate(self, dirs: list[str]) -> None:
        if not dirs:
            raise Stop("migrate needs folders")
        cfg = self.cfg
        self.mount_image()
        keep, refused = resolve(dirs)
        for r in refused:
            self.refuse(r)
        for d in keep:
            if (cfg.project and inside(os.path.realpath(cfg.project), d)) or os.path.exists(os.path.join(d, ".git")):
                self.refuse(f"refused: {d} is a repository; repositories are mounted, never migrated")
                continue
            self.migrate_one(d)

    def migrate_one(self, d: str) -> bool:
        """Move what `d` holds on the normal disk into the image, verified before anything is
        deleted. True when `d` ends up mounted with nothing left below it."""
        cfg = self.cfg
        if d in our_overlays(mounts_now(), cfg.mnt):
            self.say(f"skipped: {d} is mounted already; migrate runs before the first mount of a session")
            return False
        if not os.path.isdir(d):
            self.say(f"skipped: {d} does not exist")
            return False
        if not self.mount_dir(d, quiet=True):
            return False
        key = key_of(d)
        new = os.path.join(cfg.mnt, "upper", key + ".migrating")
        shutil.rmtree(new, ignore_errors=True)
        os.makedirs(new)
        # Copy the merged view: it already hides what was deleted and shows the newest version.
        run("cp", "-a", "--reflink=auto", f"{d}/.", f"{new}/")
        before, after = tree_sig(d), tree_sig(new)
        if before != after:
            shutil.rmtree(new)
            self.refuse(f"migrate aborted: the copy of {d} has {after} (entries, bytes), expected {before}; "
                        "nothing changed")  # fmt: skip
            return False
        run("umount", "-R", d)  # -R: with the .git bind mounts under it
        old = d + ".zstd-overlay-old"
        os.rename(d, old)
        st = os.stat(old)
        os.mkdir(d)
        os.chmod(d, st.st_mode & 0o7777)
        os.chown(d, st.st_uid, st.st_gid)
        shutil.rmtree(os.path.join(cfg.mnt, "upper", key))
        shutil.rmtree(os.path.join(cfg.mnt, "work", key), ignore_errors=True)
        os.rename(new, os.path.join(cfg.mnt, "upper", key))
        with contextlib.suppress(FileNotFoundError):
            os.unlink(self.stamp(d))
        # recover=False: `old` is this migration's own, deleted below once the check passes.
        if self.mount_dir(d, recover=False) and tree_sig(d) == before:
            shutil.rmtree(old)
            self.say(f"migrated: {d} ({gib(before[1])} now in the image)")
            return True
        self.refuse(f"migrate check failed: {old} kept; nothing deleted")
        return False

    def install(self) -> None:
        settings = Path(self.cfg.home, ".claude", "settings.json")
        me = Path(__file__).resolve()
        if me != INSTALL_PATH:
            shutil.copyfile(me, INSTALL_PATH)
            INSTALL_PATH.chmod(0o755)
        settings.parent.mkdir(parents=True, exist_ok=True)
        try:
            current = json.loads(settings.read_text()) if settings.exists() and settings.stat().st_size else {}
        except json.JSONDecodeError as e:
            raise Stop(f"{settings} is not valid JSON ({e}); left unchanged") from None
        if not isinstance(current, dict):
            raise Stop(f"{settings} is not a JSON object; left unchanged")
        fd, tmp = tempfile.mkstemp(dir=settings.parent, prefix="settings.json.")
        with os.fdopen(fd, "w") as f:
            json.dump(merge_hook(current), f, indent=2)
            f.write("\n")
        os.replace(tmp, settings)
        self.say(f"installed {INSTALL_PATH} and a SessionStart hook in {settings}")
        self.say("the image is created at the first session start, not now")

    def status(self, list_folders: bool = True) -> None:
        cfg = self.cfg
        if not mount_at(cfg.mnt):
            self.say("image not mounted (run: zstd-overlay up)")
            return
        stored = sum(
            os.lstat(os.path.join(d, f)).st_size for d, _, fs in os.walk(os.path.join(cfg.mnt, "upper")) for f in fs
        )
        free = fs_avail(os.path.dirname(cfg.img))
        self.say(
            f"stored {gib(stored)}; image capacity {gib(fs_size(cfg.mnt))} "
            f"(reserved on disk: {gib(allocated(cfg.img))}); free outside the image {gib(free)}"
        )
        if list_folders:
            for o in our_overlays(mounts_now(), cfg.mnt):
                print(f"  {o}")

    def doctor(self) -> None:
        """Every mounted folder, then every default folder that is not mounted and why. Mounted
        folders come from the kernel, so the list is right even where $CLAUDE_PROJECT_DIR is not
        set (a shell, as opposed to the hook)."""
        me = Path(__file__).resolve()
        installed = ""
        if me == INSTALL_PATH:
            when = datetime.fromtimestamp(me.stat().st_mtime, UTC).strftime("%Y-%m-%d %H:%M UTC")
            installed = f", installed {when}"
        print(f"{version_line()} ({me}{installed})")
        self.status(list_folders=False)
        image = mount_at(self.cfg.mnt) is not None
        mounted = our_overlays(mounts_now(), self.cfg.mnt)
        for d in mounted:
            print(f"  ok        {d}")
        if not self.cfg.project:
            print("  (CLAUDE_PROJECT_DIR is not set here, so the repository's folder is checked only if mounted)")
        repo_folder = os.path.realpath(workspace(self.cfg)) if self.cfg.project else ""
        for d in default_dirs(self.cfg):
            d = os.path.realpath(d)
            if d in mounted:
                continue
            elif why := guard(d, self.cfg, mounted):
                print(f"  refused   {d} ({why})")
            elif image and d == repo_folder and (n := len(self.hidden(d))):  # caches never conflict
                print(
                    f"  CHANGED   {d} ({n} files changed while unmounted that the image would hide; "
                    f"see: zstd-overlay up {d})"
                )
            else:
                print(f"  unmounted {d}")


def parent_of(pid: int) -> int:
    """The parent's pid, from /proc/<pid>/status; 0 when the process is gone."""
    try:
        status = Path(f"/proc/{pid}/status").read_text()
    except OSError:
        return 0
    return next((int(line.split()[1]) for line in status.splitlines() if line.startswith("PPid:")), 0)


def ancestors(pid: int) -> set[int]:
    """pid and every parent up to init."""
    found = set()
    while pid > 0 and pid not in found:
        found.add(pid)
        pid = parent_of(pid)
    return found


def absorb(lower: str, upper: str, mounted_ns: int | None = None) -> tuple[int, int]:
    """Move everything below `lower` (one filesystem) into `upper`, keeping modes, owners,
    times, symlinks and hard links; leave `lower` itself empty. Called while the folder is not
    mounted. A file written after the last mount (ctime newer than `mounted_ns`) replaces the
    image's version: it is the newest. A file that was already there at the last mount but did
    not show through it, because the image has its own version or deleted or replaced a folder
    above it, is a leftover (94085a131cbe's merge left such copies); it is removed. Kill-safe:
    each file is copied before its original is removed, so a kill leaves at most a file in both
    places, which the next run moves again. Returns (files moved, their bytes)."""
    dev = os.lstat(lower).st_dev
    linked: dict[tuple[int, int], str] = {}
    # Removing one name of a hard-linked file sets the inode's ctime to now: judge every name
    # by the ctime the first one had.
    ctimes: dict[tuple[int, int], int] = {}
    gone: set[str] = set()  # folders whose old contents the image hid (deleted or replaced)
    moved = size = 0

    def ensure(src_dir: str, dst_dir: str) -> None:
        if real_dir(dst_dir):
            return
        ensure(os.path.dirname(src_dir), os.path.dirname(dst_dir))
        if os.path.lexists(dst_dir):
            os.unlink(dst_dir)  # a deletion marker, file or symlink where a folder now is
        os.mkdir(dst_dir)
        st = os.lstat(src_dir)
        shutil.copystat(src_dir, dst_dir, follow_symlinks=False)
        os.lchown(dst_dir, st.st_uid, st.st_gid)

    for root, dirs, files in os.walk(lower):
        dirs[:] = [d for d in dirs if os.lstat(os.path.join(root, d)).st_dev == dev]
        dst_root = os.path.normpath(os.path.join(upper, os.path.relpath(root, lower)))
        if os.path.dirname(root) in gone or (
            os.path.lexists(dst_root) and (not real_dir(dst_root) or is_opaque(dst_root))
        ):
            gone.add(root)
        if mounted_ns is None or root not in gone:
            ensure(root, dst_root)
        for name in [d for d in dirs if os.path.islink(os.path.join(root, d))] + files:
            src, dst = os.path.join(root, name), os.path.join(dst_root, name)
            st = os.lstat(src)
            ctime = ctimes.setdefault((st.st_dev, st.st_ino), st.st_ctime_ns)
            if mounted_ns is not None and ctime <= mounted_ns and (root in gone or os.path.lexists(dst)):
                os.unlink(src)  # a leftover from before the last mount: the image's version is newer
                continue
            ensure(root, dst_root)  # a new file in a folder the image had deleted brings it back
            if real_dir(dst):
                shutil.rmtree(dst)
            elif os.path.lexists(dst):
                os.unlink(dst)
            # By inode alone: moving the first name already dropped this one's link count.
            if stat.S_ISREG(st.st_mode) and (st.st_dev, st.st_ino) in linked:
                os.link(linked[(st.st_dev, st.st_ino)], dst)
            elif stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode):
                copy_entry(src, dst)
                if stat.S_ISREG(st.st_mode) and st.st_nlink > 1:
                    linked[(st.st_dev, st.st_ino)] = dst
                size += st.st_size if stat.S_ISREG(st.st_mode) else 0
            os.unlink(src)  # sockets and fifos are not carried over: they mean nothing without their process
            moved += 1
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
    for root, dirs, _ in os.walk(lower, topdown=False):
        for d in dirs:
            with contextlib.suppress(OSError):
                os.rmdir(os.path.join(root, d))
    return moved, size


# What Claude Code reads from a repository when it starts, before the SessionStart hook mounts
# anything. These live on the normal disk, so a start after a resume reads the current ones.
STARTUP_FILES = ("CLAUDE.md", "CLAUDE.local.md", "AGENTS.md", ".mcp.json", ".claude")


# Claude Code's worktrees (.claude/worktrees/<name>) are whole checkouts, node_modules and all,
# and nothing reads them before the hook: they stay in the image.
KEPT_IN_IMAGE = ("worktrees",)


def remove(path: str) -> None:
    if real_dir(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.unlink(path)


def write_back(upper: str, lower: str, rels: list[str]) -> tuple[list[str], list[str]]:
    """Move the image's versions of `rels` (files or folders, relative to the folder) down to
    the normal disk and out of the image: a file replaces the normal disk's, a deletion marker
    deletes it, a replaced folder (opaque) replaces it whole. A folder's KEPT_IN_IMAGE entries
    stay in the image. Called while the folder is not mounted. Returns the paths written and
    the paths deleted, so the two are reported apart (a field report read "wrote 1 startup
    file back" for a delete)."""
    written: list[str] = []
    deleted: list[str] = []
    for rel in rels:
        top = os.path.join(upper, rel)
        if not os.path.lexists(top):
            continue
        if not real_dir(top):
            dst = os.path.join(lower, rel)
            remove(dst)
            if is_whiteout(os.lstat(top)):
                deleted.append(rel)
            else:
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                copy_entry(top, dst)
                written.append(rel)
            os.unlink(top)
            continue
        kept = [n for n in os.listdir(top) if n in KEPT_IN_IMAGE]
        opaque = is_opaque(top)
        for root, dirs, files in os.walk(top):
            if root == top:
                dirs[:] = [d for d in dirs if d not in kept]
                files = [f for f in files if f not in kept]
            dst_root = os.path.join(lower, os.path.relpath(root, upper))
            if is_opaque(root) or not real_dir(dst_root):
                remove(dst_root)  # the session replaced this folder: what it held before goes
                os.makedirs(dst_root)
            for name in [d for d in dirs if os.path.islink(os.path.join(root, d))] + files:
                src, dst = os.path.join(root, name), os.path.join(dst_root, name)
                remove(dst)
                if is_whiteout(os.lstat(src)):
                    deleted.append(os.path.relpath(dst, lower))
                else:
                    copy_entry(src, dst)
                    written.append(os.path.relpath(dst, lower))
            dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]
        for name in os.listdir(top):
            if name not in kept:
                remove(os.path.join(top, name))
        if not kept:
            os.rmdir(top)
        elif opaque:  # what stays must not hide the folder just written back
            os.removexattr(top, "trusted.overlay.opaque", follow_symlinks=False)
    return written, deleted


def newer_below(lower: str, upper: str) -> bool:
    """Was the normal disk's `lower`, or anything below it, changed after the image's `upper`?
    ctime on both sides, as in changed_since: `cp -a` and `tar -p` set mtime back."""
    try:
        than = os.lstat(upper).st_ctime_ns
        if os.lstat(lower).st_ctime_ns > than:
            return True
    except FileNotFoundError:
        return True
    for root, dirs, files in os.walk(lower) if real_dir(lower) else []:
        for name in dirs + files:
            with contextlib.suppress(FileNotFoundError):
                if os.lstat(os.path.join(root, name)).st_ctime_ns > than:
                    return True
    return False


def config_keys(path: str) -> list[tuple[str, str]]:
    out = subprocess.run(["git", "config", "-f", path, "--list", "--null"], capture_output=True)
    if out.returncode != 0:
        return []
    items = (i.decode(errors="surrogateescape") for i in out.stdout.split(b"\0") if i)
    return [(name, value) for name, _, value in (i.partition("\n") for i in items)]


def merge_git_config(upper: str, lower: str) -> None:
    """Add to the normal disk's .git/config the image copy's entries for keys it does not have.
    The platform rewrites .git/config on resume (remote URLs, proxy headers): a key it set keeps
    only its values, as a second url or header would make git use both. Keys only the session
    set (`git push -u` adds branch.*) carry over with all their values."""
    have = {name for name, _ in config_keys(lower)}
    for name, value in config_keys(upper):
        if name not in have:
            subprocess.run(["git", "config", "-f", lower, "--add", name, value], check=False)


def merge_tree(upper: str, lower: str) -> None:
    """Apply an overlay upper tree onto the lower tree it covered, newer wins: an upper entry
    replaces an older lower one, an upper delete (whiteout) removes an older lower one, and a
    lower entry changed after the upper one, or holding anything that was, stays. A repository's
    .git/config keeps the platform's keys and gains the session's. Nothing newer on the normal
    disk is ever removed, so a replaced folder (opaque) merges like any other."""
    for root, dirs, files in os.walk(upper):
        rel = os.path.relpath(root, upper)
        dst_root = os.path.normpath(os.path.join(lower, rel))
        if os.path.lexists(dst_root) and not real_dir(dst_root):
            if newer_below(dst_root, root):  # a newer file where the image has a folder: it stays
                dirs[:] = []
                continue
            os.unlink(dst_root)
        os.makedirs(dst_root, exist_ok=True)
        for name in [d for d in dirs if os.path.islink(os.path.join(root, d))] + files:
            src, dst = os.path.join(root, name), os.path.join(dst_root, name)
            if os.path.lexists(dst) and newer_below(dst, src):
                if name == "config" and os.path.basename(root) == ".git" and os.path.isfile(dst):
                    merge_git_config(src, dst)
                continue
            if real_dir(dst):
                shutil.rmtree(dst)
            elif os.path.lexists(dst):
                os.unlink(dst)
            if not is_whiteout(os.lstat(src)):
                copy_entry(src, dst)
        dirs[:] = [d for d in dirs if not os.path.islink(os.path.join(root, d))]


def self_hash() -> str:
    return hashlib.sha256(Path(__file__).read_bytes()).hexdigest()[:12]


def version_line(commit: str = COMMIT) -> str:
    """The hash names the bytes; the commit and its date say where they came from and how old
    they are. A file taken from a checkout, not from `git archive`, has no commit."""
    if commit.startswith("$Format"):
        origin = "working copy, not built with git archive"
    else:
        sha, _, date = commit.partition(" ")
        origin = f"commit {sha}, {date}"
    return f"zstd-overlay {self_hash()} ({origin})"


def copy_entry(src: str, dst: str) -> None:
    """Copy one file or symlink with its mode, times and owner."""
    st = os.lstat(src)
    shutil.copy2(src, dst, follow_symlinks=False)
    os.lchown(dst, st.st_uid, st.st_gid)


@contextlib.contextmanager
def locked(path: str = LOCK_PATH, wait: float = 120):
    with open(path, "w") as f:
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise Stop("another zstd-overlay is running") from None
                time.sleep(0.2)
        yield


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    cmd = args.pop(0) if args else "help"
    if cmd in ("help", "-h", "--help"):
        print(__doc__.strip())
        return 0
    if cmd in ("version", "--version"):
        print(version_line())
        return 0
    if cmd not in ("up", "migrate", "install", "status", "doctor"):
        print(f"zstd-overlay: unknown command: {cmd} (see --help)", file=sys.stderr)
        return 2
    # The hook is for cloud sessions, where CLAUDE_CODE_REMOTE is "true". A settings file that
    # reaches a laptop must not try to mount there at every session start.
    if cmd == "up" and "--hook" in args and os.environ.get("CLAUDE_CODE_REMOTE") != "true":
        return 0
    if os.geteuid() != 0:
        print("zstd-overlay: needs root (it mounts)", file=sys.stderr)
        return 2
    hook, merge = "--hook" in args, "--merge" in args
    args = [a for a in args if a not in ("--hook", "--merge")]
    if unknown := [a for a in args if a.startswith("-")]:
        print(f"zstd-overlay: unknown option: {unknown[0]} (see --help)", file=sys.stderr)
        return 2
    s = Session(Config.from_env(), quiet=hook)
    try:
        with locked():
            if cmd == "up":
                s.up(args, merge)
            elif cmd == "migrate":
                s.migrate(args)
            else:
                getattr(s, cmd)()
    except (Stop, OSError) as e:
        if not hook:
            print(f"zstd-overlay: {e}", file=sys.stderr)
            return 2
        s.refuse(f"stopped: {e}")  # a hook's report reaches Claude only on exit 0
    if hook:
        print(hook_output(s.lines, s.refused))
        return 0
    return 3 if s.refused else 0


